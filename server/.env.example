# ==============================================
# Receipt Review - Environment Configuration
# ==============================================
# Copy this file to .env and fill in the values
# NEVER commit .env to git

# ----------------------------------------------
# Database
# ----------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/receipt_review

# ----------------------------------------------
# Security Keys
# ----------------------------------------------
# Secret key for JWT tokens (min 32 characters)
SECRET_KEY=your-secret-key-here-change-in-production

# Phone number encryption (AES-GCM, 32 bytes base64 encoded)
# Generate: python -c "import secrets; import base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
PHONE_ENC_KEY=your-32-byte-base64-encoded-key==

# Phone number hashing (HMAC-SHA256)
PHONE_HMAC_KEY=your-hmac-key-here

# ----------------------------------------------
# Application Settings
# ----------------------------------------------
DEBUG=false
LOG_LEVEL=INFO

# Server URL (for generating QR codes, image URLs)
SERVER_URL=https://review.placemaster.co.kr

# Business day cutoff time (HH:MM format, default 05:00)
BUSINESS_DAY_CUTOFF=05:00

# ----------------------------------------------
# File Storage
# ----------------------------------------------
# Directory for uploaded receipts (relative to server/)
UPLOAD_DIR=uploads

# Receipt image retention hours (default: 24)
RECEIPT_RETENTION_HOURS=24

# ----------------------------------------------
# Rate Limiting
# ----------------------------------------------
# Max sessions per phone number per day
DAILY_SESSION_LIMIT=3

# Max receipt assignments per store per hour
HOURLY_ASSIGN_LIMIT=100

# ----------------------------------------------
# SMS - Aligo (Phase 8)
# ----------------------------------------------
# ALIGO_API_KEY=
# ALIGO_USER_ID=
# ALIGO_SENDER=010-0000-0000

# ----------------------------------------------
# AWS S3 - Backup (Phase 6)
# ----------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-northeast-2
# S3_BACKUP_BUCKET=receipt-review-backups

# ----------------------------------------------
# Email Notifications (Optional)
# ----------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@placemaster.co.kr
